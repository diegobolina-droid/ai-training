# Required for live LLM reviews (integration tests and production).
ANTHROPIC_API_KEY=

# Optional: override default model (see Anthropic docs for current IDs).
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Maximum characters accepted in POST /review "code" (REQ-A6 → 413 if exceeded).
MAX_REVIEW_CODE_CHARS=50000

# slowapi limit string, e.g. "30/minute" (REQ-A9).
REVIEW_RATE_LIMIT=30/minute

# Logging level: DEBUG, INFO, WARNING, ...
LOG_LEVEL=INFO

# Browser CORS: comma-separated origins allowed to call this API (e.g. your Vite app on Vercel).
# Unset → allows http://localhost:5173 and http://127.0.0.1:5173 only.
# Set empty (CORS_ORIGINS=) to disable CORS middleware entirely.
# Example: CORS_ORIGINS=https://code-review-web.vercel.app
CORS_ORIGINS=

# --- Deploy (e.g. Railway) ---
# Option A: set service root to this python/ folder; start: uvicorn main:app --host 0.0.0.0 --port $PORT
# Option B: set root to option-a-code-review/ and use ../Procfile (runs uvicorn from python/)
