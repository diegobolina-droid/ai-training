# Base URL for short links (required in production; default for local)
# In production, set to your Railway public URL, e.g. https://xxx.up.railway.app
BASE_URL=http://localhost:8000

# Optional: path to SQLite DB (default: urls.db next to main.py)
# On Railway with a volume mounted at /data, use: DB_PATH=/data/urls.db
# DB_PATH=./urls.db
